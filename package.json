{
  "name": "forest-plot-generator",
  "version": "3.1.0",
  "description": "Generate professional forest plots with multi-plot support, flexible layouts, enhanced color selection with visual preview, precise spacing controls, Excel import, and p-value display",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "test:smoke": "node --test e2e/app.smoke.js",
    "lint": "eslint .",
    "build-css": "tailwindcss -i ./src/tailwind-input.css -o ./vendor/tailwind.css --minify",
    "build": "electron-builder --win --x64",
    "build-mac": "electron-builder --mac"
  },
  "build": {
    "appId": "com.forestplot.generator",
    "productName": "Forest Plot Generator",
    "publish": null,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0",
    "electron-icon-builder": "^2.0.1",
    "eslint": "^9.39.5",
    "papaparse": "^5.4.1",
    "playwright": "^1.63.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.19"
  },
  "dependencies": {
    "xlsx": "npm:@e965/xlsx@0.20.3"
  }
}
